# LLM 供应商（至少配置一个）
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=

# 图像生成供应商（可选）
SDXL_API_KEY=
FLUX_API_KEY=

# 视频生成供应商（可选）
SEEDANCE_API_KEY=
KLING_API_KEY=

# 数据库路径（默认: ./frame-forge.db）
DB_PATH=./frame-forge.db

# 服务端口（默认: 3001）
PORT=3001

# 前端环境变量
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# 环境
NODE_ENV=development
