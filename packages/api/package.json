{
  "name": "@frame-forge/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API server for frame-forge",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@frame-forge/core": "workspace:*",
    "@frame-forge/agent-trend-scout": "workspace:*",
    "@frame-forge/agent-screenwriter": "workspace:*",
    "@frame-forge/agent-critic": "workspace:*",
    "@frame-forge/agent-storyboard": "workspace:*",
    "@frame-forge/agent-video-director": "workspace:*",
    "@frame-forge/agent-audience": "workspace:*",
    "fastify": "^5.2.1",
    "@fastify/websocket": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "drizzle-orm": "^0.39.1",
    "better-sqlite3": "^11.7.0",
    "zod": "^3.24.1",
    "nanoid": "^5.1.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7",
    "@types/better-sqlite3": "^7.6.12",
    "tsx": "^4.19.2",
    "drizzle-kit": "^0.30.1",
    "vitest": "^3.0.4"
  }
}
